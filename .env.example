# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/bikangu
DATABASE_USERNAME=bikangu
DATABASE_PASSWORD=bikangu

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-256-bits
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Security
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
PIN_LENGTH=6

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Firebase
FCM_SERVER_KEY=your-fcm-server-key
FCM_SENDER_ID=your-fcm-sender-id

# Webhook
WEBHOOK_SECRET=your-webhook-secret-change-in-production

# Providers
MOCK_PROVIDER_ENABLED=true

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:3000

# Admin Dashboard
ADMIN_PORT=3000